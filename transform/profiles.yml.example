pension_transform:
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DB_HOST', 'localhost') }}"
      port: 5432
      user: "{{ env_var('DB_USER', 'pension_user') }}"
      password: "{{ env_var('DB_PASSWORD', 'pension_password') }}"
      dbname: pension_platform
      schema: silver
      threads: 4
  target: dev